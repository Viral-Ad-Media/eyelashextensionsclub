# Neon Postgres connection string (Neon dashboard > Connection details, "pooled" is fine)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`) and the site's public URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails allowed to create an editor account and use /admin. Nobody else can sign up.
ADMIN_EMAILS="you@example.com"

# Public site URL used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL="https://eyelashextensionsclub.com"
